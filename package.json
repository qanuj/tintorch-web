{
  "name": "@tintorch/web",
  "version": "2.2.1",
  "description": "Shared pieces for TinTorch CMS sites: the CMS client, Markdown handling, slug guard, forms, badges, analytics, sitemaps, robots.txt, llms.txt and RSS.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qanuj/tintorch-web.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./badges": "./src/badges.ts",
    "./badge-link": "./src/badge-link.tsx",
    "./badge-row": "./src/badge-row.tsx",
    "./analytics": "./src/analytics.tsx",
    "./verification": "./src/verification.ts",
    "./sitemap": "./src/sitemap.ts",
    "./sitemap-stylesheet": "./src/sitemap-stylesheet.ts",
    "./robots": "./src/robots.ts",
    "./llms": "./src/llms.ts",
    "./feed": "./src/feed.ts",
    "./authors": "./src/authors.ts",
    "./usage": {
      "types": "./usage.d.mts",
      "default": "./usage.mjs"
    },
    "./cms": "./src/cms/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./slug-guard": "./src/slug-guard.ts"
  },
  "files": [
    "src",
    "usage.mjs",
    "usage.d.mts"
  ],
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
